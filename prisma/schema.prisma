// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  JUGADOR
  ARBITRO
  ORGANIZADOR

  @@map("rol_usuario")
}

enum EstadoEquipo {
  PENDIENTE
  INSCRITO
  RECHAZADO

  @@map("estado_equipo")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  rol             RolUsuario @default(JUGADOR)
  nombre          String     @db.VarChar(120)
  fechaNacimiento DateTime   @map("fecha_nacimiento") @db.Date

  refreshTokens      RefreshToken[]
  avisos             Aviso[]
  equiposCapitan     Equipo[]           @relation("CapitanEquipo")
  equiposValidados   Equipo[]           @relation("ValidadorEquipo")
  jornadasPublicadas Jornada[]          @relation("PublicadorJornada")
  jugador            Jugador?
  partidosArbitro    Partido[]          @relation("ArbitroPartido")
  bitacorasMarcador  BitacoraMarcador[]
  cuotasCreadas Cuota[] @relation("CreadorCuota")
  pagosRegistrados Pago[]           @relation("RegistradorPago")
  cambiosPartido   CambioPartido[]  @relation("ModificadorCambio")
  entregasCorreo   EntregaCorreo[]  @relation("DestinatarioEntrega")
  contenidosSubidos    ContenidoGaleria[] @relation("SubidoPorGaleria")
  contenidosEliminados ContenidoGaleria[] @relation("EliminadoPorGaleria")

  @@map("usuario")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// H1: inscripción de equipos y jugadores (DB-1.1, DB-2.1)
//
// Lo que Prisma no expresa vive en el .sql de la migración:
//  - índice parcial ux_temporada_actual (una sola temporada con actual = TRUE)
//  - índice uq_equipo_nombre_temporada con lower(nombre)
//  - CHECK de fechas, max_equipos, nombre/nacimiento de usuario y ck_equipo_validacion
// ---------------------------------------------------------------------------

model Temporada {
  id                 Int      @id @default(autoincrement())
  nombre             String   @unique @db.VarChar(80)
  fechaInicio        DateTime @map("fecha_inicio") @db.Date
  fechaFin           DateTime @map("fecha_fin") @db.Date
  maxEquipos         Int      @default(12) @map("max_equipos") @db.SmallInt
  inscripcionAbierta Boolean  @default(true) @map("inscripcion_abierta")
  actual             Boolean  @default(false)

  equipos  Equipo[]
  jornadas Jornada[]

  @@map("temporada")
}

model Equipo {
  id          Int          @id @default(autoincrement())
  nombre      String       @db.VarChar(50)
  temporadaId Int          @map("temporada_id")
  capitanId   String       @map("capitan_id") @db.Uuid
  estado      EstadoEquipo @default(PENDIENTE)
  creadoEn    DateTime     @default(now()) @map("creado_en") @db.Timestamptz(3)

  // DB-2.1
  motivoRechazo   String?   @map("motivo_rechazo")
  validadoPor     String?   @map("validado_por") @db.Uuid
  fechaValidacion DateTime? @map("fecha_validacion") @db.Timestamptz(3)

  temporada         Temporada       @relation(fields: [temporadaId], references: [id])
  capitan           User            @relation("CapitanEquipo", fields: [capitanId], references: [id])
  validador         User?           @relation("ValidadorEquipo", fields: [validadoPor], references: [id], onDelete: Restrict)
  jugadores         EquipoJugador[]
  partidosLocal     Partido[]       @relation("PartidoLocal")
  partidosVisitante Partido[]       @relation("PartidoVisitante")
  posiciones        Posicion[]
  cuotas Cuota[]

  @@unique([id, temporadaId])
  @@unique([temporadaId, capitanId])
  @@index([temporadaId, estado], map: "ix_equipo_temporada_estado")
  @@map("equipo")
}

model Jugador {
  id              Int      @id @default(autoincrement())
  nombreCompleto  String   @map("nombre_completo") @db.VarChar(120)
  fechaNacimiento DateTime @map("fecha_nacimiento") @db.Date
  identificacion  String   @unique @db.VarChar(20)
  fotoUrl         String   @map("foto_url")
  usuarioId       String?  @unique @map("usuario_id") @db.Uuid

  usuario User?           @relation(fields: [usuarioId], references: [id])
  equipos EquipoJugador[]
  estadisticas EstadisticaPartido[]

  @@map("jugador")
}

model EquipoJugador {
  equipoId    Int @map("equipo_id")
  jugadorId   Int @map("jugador_id")
  temporadaId Int @map("temporada_id")

  jugador Jugador @relation(fields: [jugadorId], references: [id])
  equipo  Equipo  @relation(fields: [equipoId, temporadaId], references: [id, temporadaId], onDelete: Cascade)

  participaciones ParticipacionPartido[]

  @@id([equipoId, jugadorId])
  @@unique([temporadaId, jugadorId])
  @@index([equipoId], map: "ix_equipo_jugador_equipo")
  @@map("equipo_jugador")
}

enum EstadoPartido {
  PROGRAMADO
  EN_CURSO
  FINALIZADO
  CANCELADO

  @@map("estado_partido")
}

enum EstadoJornada {
  BORRADOR
  PUBLICADA

  @@map("estado_jornada")
}

model Cancha {
  id        Int     @id @default(autoincrement())
  nombre    String  @db.VarChar(80)
  direccion String  @db.VarChar(200)
  activa    Boolean @default(true)

  partidos Partido[]

  @@map("cancha")
}

model Jornada {
  id          Int           @id @default(autoincrement())
  temporadaId Int           @map("temporada_id")
  numero      Int           @db.SmallInt
  estado      EstadoJornada @default(BORRADOR)

  temporada  Temporada @relation(fields: [temporadaId], references: [id])
  publicador User?     @relation("PublicadorJornada", fields: [publicadaPorId], references: [id], onDelete: Restrict)
  partidos   Partido[]

  publicadaEn    DateTime? @map("publicada_en") @db.Timestamptz(3)
  publicadaPorId String?   @map("publicada_por") @db.Uuid

  @@unique([temporadaId, numero])
  @@unique([id, temporadaId])
  @@map("jornada")
}

model Partido {
  id                Int           @id @default(autoincrement())
  temporadaId       Int           @map("temporada_id")
  jornadaId         Int           @map("jornada_id")
  equipoLocalId     Int           @map("equipo_local_id")
  equipoVisitanteId Int           @map("equipo_visitante_id")
  canchaId          Int           @map("cancha_id")
  arbitroId         String        @map("arbitro_id") @db.Uuid
  inicio            DateTime      @db.Timestamptz(3)
  fin               DateTime      @db.Timestamptz(3)
  estado            EstadoPartido @default(PROGRAMADO)

  cancha    Cancha  @relation(fields: [canchaId], references: [id])
  arbitro   User    @relation("ArbitroPartido", fields: [arbitroId], references: [id])
  jornada   Jornada @relation(fields: [jornadaId, temporadaId], references: [id, temporadaId])
  local     Equipo  @relation("PartidoLocal", fields: [equipoLocalId, temporadaId], references: [id, temporadaId])
  visitante Equipo  @relation("PartidoVisitante", fields: [equipoVisitanteId, temporadaId], references: [id, temporadaId])

  golesLocal      Int       @default(0) @map("goles_local")
  golesVisitante  Int       @default(0) @map("goles_visitante")
  faltasLocal     Int       @default(0) @map("faltas_local")
  faltasVisitante Int       @default(0) @map("faltas_visitante")
  inicioReal      DateTime? @map("inicio_real") @db.Timestamptz(3)
  finReal         DateTime? @map("fin_real") @db.Timestamptz(3)

  bitacoras       BitacoraMarcador[]
  participaciones ParticipacionPartido[]
  estadisticas EstadisticaPartido[]
  cuotas       Cuota[]
  cambios CambioPartido[]
  galeria ContenidoGaleria[]

  @@index([equipoLocalId, inicio], map: "ix_partido_local_inicio")
  @@index([equipoVisitanteId, inicio], map: "ix_partido_visitante_inicio")
  @@index([temporadaId, jornadaId], map: "ix_partido_temporada_jornada")
  @@map("partido")
}

enum ModuloOrigenAviso {
  CALENDARIO
  PAGOS
  RESULTADOS

  @@map("modulo_origen_aviso")
}

enum TipoAviso {
  PARTIDO_MODIFICADO
  JORNADA_PUBLICADA
  CUOTA_REGISTRADA
  PAGO_REGISTRADO
  RESULTADO_FINALIZADO
  RESULTADO_CORREGIDO

  @@map("tipo_aviso")
}

enum ReferenciaAviso {
  PARTIDO
  JORNADA
  CUOTA
  PAGO

  @@map("referencia_aviso")
}

model Aviso {
  id                Int               @id @default(autoincrement())
  usuarioId         String            @map("usuario_id") @db.Uuid
  moduloOrigen      ModuloOrigenAviso @map("modulo_origen")
  tipo              TipoAviso
  titulo            String            @db.VarChar(120)
  mensaje           String            @db.VarChar(500)
  referenciaTipo    ReferenciaAviso?  @map("referencia_tipo")
  referenciaId      Int?              @map("referencia_id")
  claveIdempotencia String?           @map("clave_idempotencia") @db.VarChar(100)
  creadoEn          DateTime          @default(now()) @map("creado_en") @db.Timestamptz(3)
  leidoEn           DateTime?         @map("leido_en") @db.Timestamptz(3)
  datos             Json?             @db.JsonB

  usuario User @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, claveIdempotencia], map: "aviso_usuario_id_clave_idempotencia_key")
  @@index([usuarioId, creadoEn(sort: Desc)], map: "ix_aviso_usuario_fecha")
  @@map("aviso")
}

model BitacoraMarcador {
  id              Int      @id @default(autoincrement())
  partidoId       Int      @map("partido_id")
  usuarioId       String   @map("usuario_id") @db.Uuid
  golesLocal      Int      @map("goles_local")
  golesVisitante  Int      @map("goles_visitante")
  faltasLocal     Int      @map("faltas_local")
  faltasVisitante Int      @map("faltas_visitante")
  accion          String   @db.VarChar(10) // INICIAR | ACTUALIZAR | FINALIZAR (CHECK en la base)
  fechaRegistro   DateTime @default(now()) @map("fecha_registro") @db.Timestamptz(3)

  partido Partido @relation(fields: [partidoId], references: [id])
  usuario User    @relation(fields: [usuarioId], references: [id])

  @@index([partidoId], map: "ix_bitacora_partido")
  @@map("bitacora_marcador")
}

model ParticipacionPartido {
  partidoId Int @map("partido_id")
  jugadorId Int @map("jugador_id")
  equipoId  Int @map("equipo_id")

  partido       Partido       @relation(fields: [partidoId], references: [id])
  equipoJugador EquipoJugador @relation(fields: [equipoId, jugadorId], references: [equipoId, jugadorId])

  @@id([partidoId, jugadorId])
  @@map("participacion_partido")
}

model Posicion {
  id          Int @id @default(autoincrement())
  temporadaId Int @map("temporada_id")
  equipoId    Int @map("equipo_id")
  pj          Int @default(0)
  pg          Int @default(0)
  pe          Int @default(0)
  pp          Int @default(0)
  gf          Int @default(0)
  gc          Int @default(0)
  dg          Int @default(0)
  puntos      Int @default(0)

  equipo Equipo @relation(fields: [equipoId, temporadaId], references: [id, temporadaId])

  @@unique([temporadaId, equipoId])
  @@map("posicion")
}

enum ConceptoCuota {
  INSCRIPCION
  ARBITRAJE

  @@map("concepto_cuota")
}

model EstadisticaPartido {
  id            Int      @id @default(autoincrement())
  partidoId     Int      @map("partido_id")
  jugadorId     Int      @map("jugador_id")
  goles         Int      @default(0)
  asistencias   Int      @default(0)
  tarjetas      Int      @default(0)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  partido Partido @relation(fields: [partidoId], references: [id])
  jugador Jugador @relation(fields: [jugadorId], references: [id])

  @@unique([partidoId, jugadorId])
  @@map("estadistica_partido")
}

model Cuota {
  id               Int           @id @default(autoincrement())
  temporadaId      Int           @map("temporada_id")
  equipoId         Int           @map("equipo_id")
  concepto         ConceptoCuota
  partidoId        Int?          @map("partido_id")
  monto            Decimal       @db.Decimal(12, 2)
  fechaVencimiento DateTime      @map("fecha_vencimiento") @db.Date
  creadoPor        String        @map("creado_por") @db.Uuid
  creadoEn         DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)

  equipo  Equipo   @relation(fields: [equipoId, temporadaId], references: [id, temporadaId])
  // Restrict explícito: en una relación opcional Prisma pondría SetNull por defecto y la
  // base (ON DELETE RESTRICT) quedaría distinta del schema.
  partido Partido? @relation(fields: [partidoId], references: [id], onDelete: Restrict)
  creador User     @relation("CreadorCuota", fields: [creadoPor], references: [id])
  pagos Pago[]

  @@map("cuota")
}

enum EstadoPago {
  PENDIENTE
  VERIFICADO
  RECHAZADO

  @@map("estado_pago")
}

enum CampoCambioPartido {
  FECHA
  HORA
  CANCHA

  @@map("campo_cambio_partido")
}

enum EstadoEntregaCorreo {
  PENDIENTE
  ENVIADO
  FALLIDO
  OMITIDO

  @@map("estado_entrega_correo")
}

model Pago {
  id                Int        @id @default(autoincrement())
  cuotaId           Int        @map("cuota_id")
  monto             Decimal    @db.Decimal(12, 2)
  fechaPago         DateTime   @map("fecha_pago") @db.Date
  comprobanteClave  String     @unique @map("comprobante_clave") @db.VarChar(255)
  comprobanteMime   String     @map("comprobante_mime") @db.VarChar(100)
  comprobanteBytes  Int        @map("comprobante_bytes")
  estado            EstadoPago @default(PENDIENTE)
  registradoPor     String     @map("registrado_por") @db.Uuid
  creadoEn          DateTime   @default(now()) @map("creado_en") @db.Timestamptz(3)
  claveIdempotencia String?    @map("clave_idempotencia") @db.VarChar(100)

  cuota       Cuota @relation(fields: [cuotaId], references: [id])
  registrador User  @relation("RegistradorPago", fields: [registradoPor], references: [id])

  @@unique([registradoPor, claveIdempotencia], map: "pago_registrado_por_clave_idempotencia_key")
  @@index([cuotaId, estado], map: "ix_pago_cuota_estado")
  @@map("pago")
}

model CambioPartido {
  id              Int                @id @default(autoincrement())
  partidoId       Int                @map("partido_id")
  campoModificado CampoCambioPartido @map("campo_modificado")
  valorAnterior   String             @map("valor_anterior")
  valorNuevo      String             @map("valor_nuevo")
  modificadoPor   String             @map("modificado_por") @db.Uuid
  modificadoEn    DateTime           @default(now()) @map("modificado_en") @db.Timestamptz(3)

  partido     Partido         @relation(fields: [partidoId], references: [id])
  modificador User            @relation("ModificadorCambio", fields: [modificadoPor], references: [id])
  entregas    EntregaCorreo[]

  @@index([partidoId, modificadoEn], map: "ix_cambio_partido_partido_fecha")
  @@map("cambio_partido")
}

model EntregaCorreo {
  cambioId        Int                 @map("cambio_id")
  usuarioId       String              @map("usuario_id") @db.Uuid
  estado          EstadoEntregaCorreo @default(PENDIENTE)
  intentos        Int                 @default(0) @db.SmallInt
  ultimoIntentoEn DateTime?           @map("ultimo_intento_en") @db.Timestamptz(3)

  cambio  CambioPartido @relation(fields: [cambioId], references: [id])
  usuario User          @relation("DestinatarioEntrega", fields: [usuarioId], references: [id])

  @@id([cambioId, usuarioId])
  @@index([estado], map: "ix_entrega_correo_estado")
  @@map("entrega_correo")
}

enum TipoContenidoGaleria {
  FOTO
  VIDEO

  @@map("tipo_contenido_galeria")
}

enum EstadoContenidoGaleria {
  ACTIVO
  ELIMINADO

  @@map("estado_contenido_galeria")
}

model ContenidoGaleria {
  id             String                 @id @default(uuid()) @db.Uuid
  partidoId      Int                    @map("partido_id")
  tipo           TipoContenidoGaleria
  storageKey     String                 @unique @map("storage_key") @db.VarChar(255)
  nombreOriginal String                 @map("nombre_original") @db.VarChar(255)
  mimeType       String                 @map("mime_type") @db.VarChar(100)
  tamanoBytes    Int                    @map("tamano_bytes")
  descripcion    String?                @db.VarChar(200)
  subidoPor      String                 @map("subido_por") @db.Uuid
  creadoEn       DateTime               @default(now()) @map("creado_en") @db.Timestamptz(3)
  estado         EstadoContenidoGaleria @default(ACTIVO)
  eliminadoEn    DateTime?              @map("eliminado_en") @db.Timestamptz(3)
  eliminadoPorId String?                @map("eliminado_por") @db.Uuid

  partido    Partido @relation(fields: [partidoId], references: [id])
  subidor    User    @relation("SubidoPorGaleria", fields: [subidoPor], references: [id])
  // Restrict explícito: en una relación opcional Prisma pondría SetNull por defecto y la
  // base (ON DELETE RESTRICT) quedaría distinta del schema.
  eliminador User?   @relation("EliminadoPorGaleria", fields: [eliminadoPorId], references: [id], onDelete: Restrict)

  @@index([partidoId, creadoEn(sort: Desc), id(sort: Desc)], map: "ix_galeria_partido_fecha")
  @@map("contenido_galeria")
}

