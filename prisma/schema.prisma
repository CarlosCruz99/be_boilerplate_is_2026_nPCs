// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  JUGADOR
  ARBITRO
  ORGANIZADOR

  @@map("rol_usuario")
}

enum EstadoEquipo {
  PENDIENTE
  INSCRITO
  RECHAZADO

  @@map("estado_equipo")
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String      @map("password_hash")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // DB-1.3. Los defaults de nombre y fechaNacimiento solo cubren al usuario
  // existente; se quitan cuando BE-1.3 envíe estos datos desde el registro.
  rol             RolUsuario @default(JUGADOR)
  nombre          String     @default("Usuario de prueba") @db.VarChar(120)
  fechaNacimiento DateTime   @default(dbgenerated("'2000-01-01'::date")) @map("fecha_nacimiento") @db.Date

  refreshTokens   RefreshToken[]
  equiposCapitan  Equipo[]       @relation("CapitanEquipo")
  equiposValidados Equipo[]      @relation("ValidadorEquipo")
  jugador         Jugador?

  @@map("usuario")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// H1: inscripción de equipos y jugadores (DB-1.1, DB-2.1)
//
// Lo que Prisma no expresa vive en el .sql de la migración:
//  - índice parcial ux_temporada_actual (una sola temporada con actual = TRUE)
//  - índice uq_equipo_nombre_temporada con lower(nombre)
//  - CHECK de fechas, max_equipos, nombre/nacimiento de usuario y ck_equipo_validacion
// ---------------------------------------------------------------------------

model Temporada {
  id                 Int      @id @default(autoincrement())
  nombre             String   @unique @db.VarChar(80)
  fechaInicio        DateTime @map("fecha_inicio") @db.Date
  fechaFin           DateTime @map("fecha_fin") @db.Date
  maxEquipos         Int      @default(12) @map("max_equipos") @db.SmallInt
  inscripcionAbierta Boolean  @default(true) @map("inscripcion_abierta")
  actual             Boolean  @default(false)

  equipos Equipo[]

  @@map("temporada")
}

model Equipo {
  id          Int          @id @default(autoincrement())
  nombre      String       @db.VarChar(50)
  temporadaId Int          @map("temporada_id")
  capitanId   String       @map("capitan_id") @db.Uuid
  estado      EstadoEquipo @default(PENDIENTE)
  creadoEn    DateTime     @default(now()) @map("creado_en") @db.Timestamptz(3)

  // DB-2.1
  motivoRechazo   String?   @map("motivo_rechazo")
  validadoPor     String?   @map("validado_por") @db.Uuid
  fechaValidacion DateTime? @map("fecha_validacion") @db.Timestamptz(3)

  temporada Temporada @relation(fields: [temporadaId], references: [id])
  capitan   User      @relation("CapitanEquipo", fields: [capitanId], references: [id])
  validador User? @relation("ValidadorEquipo", fields: [validadoPor], references: [id], onDelete: Restrict)
  jugadores EquipoJugador[]

  @@unique([id, temporadaId])
  @@unique([temporadaId, capitanId])
  @@index([temporadaId, estado], map: "ix_equipo_temporada_estado")
  @@map("equipo")
}

model Jugador {
  id              Int      @id @default(autoincrement())
  nombreCompleto  String   @map("nombre_completo") @db.VarChar(120)
  fechaNacimiento DateTime @map("fecha_nacimiento") @db.Date
  identificacion  String   @unique @db.VarChar(20)
  fotoUrl         String   @map("foto_url")
  usuarioId       String?  @unique @map("usuario_id") @db.Uuid

  usuario User?           @relation(fields: [usuarioId], references: [id])
  equipos EquipoJugador[]

  @@map("jugador")
}

model EquipoJugador {
  equipoId    Int @map("equipo_id")
  jugadorId   Int @map("jugador_id")
  temporadaId Int @map("temporada_id")

  jugador Jugador @relation(fields: [jugadorId], references: [id])
  equipo  Equipo  @relation(fields: [equipoId, temporadaId], references: [id, temporadaId], onDelete: Cascade)

  @@id([equipoId, jugadorId])
  @@unique([temporadaId, jugadorId])
  @@index([equipoId], map: "ix_equipo_jugador_equipo")
  @@map("equipo_jugador")
}
